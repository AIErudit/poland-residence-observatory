  "definitions": [
    {
      "id": "eurostat_first_permit_context",
      "label": "Eurostat first residence permits: context only",
      "description": "Annual authorisations for non-EU citizens to stay at least3months. A first permit can also follow a gap of at least6months after an earlier permit. National long-stay visas/status grants may be included under the statistical definition. TOTAL aggregates citizenship within this collection; BY means Belarus citizenship, not ethnic origin. Reported PER/Person unit is preserved. These are not applications, waiting times, the resident stock, or the same scope as Polish temporary-residence case resolutions."
    }
  ],
